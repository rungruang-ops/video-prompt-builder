# ─── Video Prompt Builder — environment variables ────────────────────────────
# Quick start:  npm run env:init      (copies this file to .env and fills every CHANGE-ME with random secrets)
#   or by hand: cp .env.example .env  and replace each CHANGE-ME (openssl commands below).
# This file contains placeholders only — never commit a real .env.
NODE_ENV=development
LOG_LEVEL=info
# Trusted proxy hops in front of the API: 1 = nginx (docker) or Vercel's edge. Use 2 if another reverse proxy sits in
# front of nginx; false if the API port is exposed directly (otherwise clients could spoof X-Forwarded-For).
TRUST_PROXY=1

# Web port published by docker compose (nginx serving the UI + proxying /api)
WEB_PORT=8080

# ── Database (docker compose creates the DB with these credentials) ──
POSTGRES_USER=vpb
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=vpb
# Native/dev mode (outside Docker). In docker compose the api container builds its own URL from POSTGRES_*.
# Production refuses the default password "vpb" and any CHANGE-ME placeholder.
DATABASE_URL=postgres://vpb:vpb@localhost:5432/vpb
# false | true (TLS, certificate verified — Neon/RDS/Supabase) | no-verify (self-signed only)
DATABASE_SSL=false
# Connection pool size (serverless/Vercel: 1-3 with a pooled connection string)
DB_POOL_MAX=10
# Run migrations + seed system presets when the API starts (Vercel: false → use `npm run migrate`)
MIGRATE_ON_START=true

# ── Redis (rate limits + LLM quotas). Empty = in-memory fallback (single instance only) ──
# docker compose starts Redis with requirepass REDIS_PASSWORD and builds the api's REDIS_URL from it
# (use URL-safe characters: letters, digits, - and _ ; generate: openssl rand -base64 24 | tr '+/' '-_' | tr -d '=').
REDIS_PASSWORD=CHANGE-ME
# Native/dev mode (outside Docker). With a password: redis://:<password>@localhost:6379
# Upstash: rediss://default:<password>@<host>.upstash.io:6379
REDIS_URL=redis://localhost:6379

# ── Security (REQUIRED) ──
# JWT_SECRET: >= 32 random chars          →  openssl rand -base64 48
JWT_SECRET=CHANGE-ME
JWT_EXPIRES_IN=7d
# ENCRYPTION_KEY: 32 random bytes, base64 →  openssl rand -base64 32
# Encrypts per-user provider API keys (AES-256-GCM). Keep it stable and backed up — losing it makes saved keys unreadable.
ENCRYPTION_KEY=CHANGE-ME
# true when served over HTTPS (production / Vercel)
COOKIE_SECURE=false
COOKIE_NAME=vpb_session
# Comma-separated browser origins allowed to call the API with cookies (same-origin deployments don't need this)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ── Users ──
# If ADMIN_EMAIL/ADMIN_PASSWORD are empty the FIRST registered user becomes admin —
# on a public deployment set them (or register immediately) so nobody else claims admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
REGISTRATION_OPEN=true

# ── Limits ──
API_RATE_PER_MIN=300
AUTH_RATE_PER_MIN=10
LLM_RATE_PER_MIN=20
LLM_DAILY_QUOTA=200
# Per-attempt timeout, retries, and the overall budget per AI request (keep below the platform limit, e.g. Vercel maxDuration)
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
LLM_TOTAL_TIMEOUT_MS=110000

# ── LLM providers ──
# Users may store their own (encrypted) keys in the UI when ALLOW_USER_KEYS=true.
# Server keys below are used when a user has no key of their own.
ALLOW_USER_KEYS=true
# Who may point a provider at their own base URL: off (default — env URLs only) | admin | all
# User URLs are SSRF-checked (private/loopback/link-local/metadata IPs refused) and never receive the server's API keys.
ALLOW_USER_BASE_URL=off
# Hostnames user URLs may use even if they resolve to private IPs (e.g. ollama.lan,*.corp.example)
LLM_URL_ALLOWLIST=
# Disable the private-IP check entirely (trusted internal deployments only)
LLM_ALLOW_PRIVATE_URLS=false
# Provider used when a user has not chosen one: openai|gemini|anthropic|xai|openrouter|ollama|custom (empty = offline)
DEFAULT_LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
XAI_API_KEY=
XAI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Ollama: from Docker the api uses http://host.docker.internal:11434/v1 automatically
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=
# Any OpenAI-compatible server (vLLM, LM Studio, LiteLLM...).
# Bundled stub for demos/tests: http://localhost:9999/v1 (docker: http://stub-llm:9999/v1) + CUSTOM_LLM_MODEL=stub-model.
# With NODE_ENV=production the API refuses to start against the stub unless ALLOW_STUB_LLM=true.
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=
ALLOW_STUB_LLM=false
# Optional base URL overrides (gateways / regional endpoints)
OPENAI_BASE_URL=
GEMINI_BASE_URL=
ANTHROPIC_BASE_URL=
XAI_BASE_URL=
OPENROUTER_BASE_URL=
